{
  "expo": {
    "name": "Morrow",
    "slug": "morrow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "morrow",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#221A2E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.morriswch.morrow",
      "backgroundModes": ["audio"],
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#221A2E"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.morrow.app",
      "permissions": ["SCHEDULE_EXACT_ALARM", "USE_EXACT_ALARM", "VIBRATE", "RECEIVE_BOOT_COMPLETED"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      ["expo-notifications", { "sounds": ["./assets/sounds/alarm_default.wav"] }],
      ["expo-av", { "microphonePermission": "Allow $(PRODUCT_NAME) to record custom alarm sounds." }]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4397f958-518c-46e6-95d3-b02beb2caa61"
      }
    }
  }
}
